{
    "buildCommand": "d=$PWD;until [ -f \"$d/build.sh\" ]||[ -z \"$d\" ];do d=${d%/*};done;bash \"$d/tool/vercel_build.sh\" \"$PWD\"",
    "outputDirectory": "build/web",
    "installCommand": "echo 'No npm install needed'",
    "framework": null,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
