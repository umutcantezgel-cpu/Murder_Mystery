{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Erkundung des langen Abends",
  "description": "content/welt/<akte>/erkundung.json: Erkundungsorte und Treffpunkte des Streifzugs (M7b). Je Ort eine Ebene, ein Ziel (Ort, Einrichtung oder Kachel der Ebene), Titel und ein bis drei Stichpunkte zu je höchstens acht Wörtern (R17), optional kosmetische Varianten. Treffpunkte sind Orte im Erdgeschoss oder Turm mit einer Anzeigeform für „Triff X …“. Reine Stimmung, in allen Pfaden gleich, ohne Fallhinweis (R15). Inhaltliche Regeln prüft pruefeErkundung.",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "punkte": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "ziel": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "ort"
          ],
          "additionalProperties": false,
          "properties": {
            "ort": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ding"
          ],
          "additionalProperties": false,
          "properties": {
            "ding": {
              "$ref": "#/$defs/id"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "kachel"
          ],
          "additionalProperties": false,
          "properties": {
            "kachel": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      ]
    },
    "ort": {
      "type": "object",
      "required": [
        "id",
        "ebene",
        "ziel",
        "titel",
        "stichpunkte"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ebene": {
          "$ref": "#/$defs/id"
        },
        "ziel": {
          "$ref": "#/$defs/ziel"
        },
        "titel": {
          "$ref": "#/$defs/text"
        },
        "stichpunkte": {
          "$ref": "#/$defs/punkte"
        },
        "varianten": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/punkte"
          }
        }
      }
    },
    "treffpunkt": {
      "type": "object",
      "required": [
        "id",
        "ebene",
        "ort",
        "anzeige"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "ebene": {
          "$ref": "#/$defs/id"
        },
        "ort": {
          "$ref": "#/$defs/id"
        },
        "anzeige": {
          "$ref": "#/$defs/text"
        }
      }
    }
  },
  "type": "object",
  "required": [
    "format",
    "akte",
    "orte",
    "treffpunkte"
  ],
  "additionalProperties": false,
  "properties": {
    "format": {
      "const": "erkundung/1"
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "akte": {
      "$ref": "#/$defs/id"
    },
    "orte": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/ort"
      }
    },
    "treffpunkte": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/treffpunkt"
      }
    }
  }
}
