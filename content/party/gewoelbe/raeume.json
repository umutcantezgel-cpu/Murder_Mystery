      "rechteck": {
        "x": 1,
        "y": 5,
        "b": 14,
        "l": 6
      },
      "boden": "stone",
      "features": [
        "Brunnen mit Geleucht",
        "Burgtor",
        "Raureif"
      ],
      "beschreibung": "Der Burghof mit dem Brunnen und der Solarlaterne, die der Burgwart Geleucht nennt. Seit elf Uhr liegt Raureif auf dem Pflaster. Das Burgtor ist abgeschlossen."
    },
    {
      "id": "wehrgang",
      "name": "Wehrgang",
      "anzeigename": "Wehrgang",
      "rechteck": {
        "x": 16,
        "y": 1,
        "b": 10,
        "l": 2
      },
      "boden": "stone",
      "features": [
        "dritte Zinne",
        "Handyempfang"
      ],
      "beschreibung": "Der schmale Wehrgang oben auf dem Turm. An der dritten Zinne gibt es als einziger Stelle der Burg Handyempfang. Nachts ist der Wehrgang verboten."
    },
    {
      "id": "hofebene",
      "name": "Hofebene",
      "anzeigename": "Hofebene",
      "rechteck": {
        "x": 16,
        "y": 4,
        "b": 6,
        "l": 3
      },
      "boden": "stone",
      "features": [
        "Hoftür",
        "Schauvitrine",
        "Toilette"
      ],
      "beschreibung": "Die Ebene im Turm, die zum Hof führt. Hier stehen die Schauvitrine mit der Samtmulde und die Toilette. Der Wäschekorb steht gleich daneben."
    },
    {
      "id": "turm_absatz",
      "name": "Erster Absatz",
      "anzeigename": "Erster Absatz",
      "rechteck": {
        "x": 16,
        "y": 8,
        "b": 6,
        "l": 3
      },
      "boden": "stone",
      "features": [
        "Rüstung Kunibert",
        "Wendeltreppe"
      ],
      "beschreibung": "Acht Stufen über dem Turm-Fuß steht auf dem ersten Absatz die Rüstung Kunibert. Ihr rechter Panzerhandschuh ist nach vorn verbogen."
    },
    {
      "id": "turm_fuss",
      "name": "Turm-Fuß",
      "anzeigename": "Turm-Fuß",
      "rechteck": {
        "x": 16,
        "y": 12,
        "b": 6,
        "l": 4
      },
      "boden": "stone",
      "features": [
        "Sicherungskasten mit Zahlenschloss",
        "Holztruhe",
        "Eisentür",
        "Turmtür"
      ],
      "beschreibung": "Der Fuß des Wendeltreppenturms. Hier stehen der Sicherungskasten und die alte Holztruhe. Zwei Türen führen weg: die Turmtür ins Gewölbe und die Eisentür zur Speisekammer."
    },
    {
      "id": "speisekammer",
      "name": "Speisekammer",
      "anzeigename": "Speisekammer",
      "rechteck": {
        "x": 16,
        "y": 17,
        "b": 6,
        "l": 6
      },
      "boden": "stone",
      "features": [
        "Regal mit Konserven",
        "Tonne",
        "Kartoffelkisten",
        "Tiefkühltruhe",
        "Eisentür",
        "Eichentür"
      ],
      "beschreibung": "Die Speisekammer hat keine Fenster und zwei Türen. Die Eichentür zum Gewölbe ist von innen verkeilt. Die Eisentür zum Turm quietscht laut, sobald man sie aufzieht."
    },
    {
      "id": "kamin_gewoelbe",
      "name": "Kamin-Gewölbe",
      "anzeigename": "Kamin-Gewölbe",
      "rechteck": {
        "x": 1,
        "y": 12,
        "b": 14,
        "l": 11
      },
      "boden": "stone",
      "features": [
        "Kamin",
        "Festtafel",
        "Punschkessel",
        "Fotowand",
        "Nische mit der Box"
      ],
      "beschreibung": "Der Festsaal im Keller mit Bruchsteinwänden, einem großen Kamin und der langen Festtafel. Neben der verkeilten Eichentür steht die Bluetooth-Box in einer Nische."
    }
