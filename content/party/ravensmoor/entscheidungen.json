    {
      "id": "e2_1",
      "runde": 2,
      "nr": 1,
      "art": "gegenstand",
      "frage": "Wessen Heimlichtuerei klärst du jetzt?",
      "optionen": [
        {
          "id": "e2_1_salonkamin",
          "ziel": {
            "gegenstand": "salonkamin"
          },
          "text": "Den Kamin im Salon untersuchen",
          "fakten": [
            "f_nd_witwe",
            "f_z_witwe"
          ]
        },
        {
          "id": "e2_1_westentasche",
          "ziel": {
            "gegenstand": "pfandschein_julian"
          },
          "text": "Julians Westentasche untersuchen",
          "fakten": [
            "f_nd_neffe",
            "f_z_neffe"
          ]
        }
      ],
      "richtig": {
        "witwe": "e2_1_salonkamin",
        "butler": "e2_1_salonkamin",
        "aerztin": "e2_1_salonkamin",
        "neffe": "e2_1_westentasche"
      },
      "begruendung": {
        "witwe": {
          "kette": [
            "fakt:f_spaet_witwe",
            "karte:salonkamin"
          ],
          "text": "Lady Constance war beim Donnerschlag nicht in ihrem Zimmer. Im Kamin des Salons liegen frische Papierreste. Wer nachts Papier verbrennt, hat etwas zu verbergen."
        },
        "butler": {
          "kette": [
            "fakt:f_alibi_witwe",
            "luege:luege_witwe_post",
            "karte:salonkamin"
          ],
          "text": "Lady Constance lag beim Donnerschlag im Bett und hat damit ein Alibi. Doch sie sagt, sie bekomme keine Post aus London, und im Salonkamin liegen Papierreste. Ihre Heimlichtuerei kann sie zusammen mit dem Alibi entlasten."
        },
        "aerztin": {
          "kette": [
            "fakt:f_alibi_witwe",
            "luege:luege_witwe_post",
            "karte:salonkamin"
          ],
          "text": "Lady Constance lag beim Donnerschlag im Bett und hat damit ein Alibi. Doch sie sagt, sie bekomme keine Post aus London, und im Salonkamin liegen Papierreste. Ihre Heimlichtuerei kann sie zusammen mit dem Alibi entlasten."
        },
        "neffe": {
          "kette": [
            "fakt:f_alibi_butler",
            "fakt:f_alibi_aerztin",
            "beobachtung:b_koechin_uhr",
            "merkmal:neffe"
          ],
          "text": "Pell und Doktor Marsh waren beim Donnerschlag nachweislich woanders. Julian trug beim Dinner keine Taschenuhr und greift ständig an seine Westentasche. Dort steckt vielleicht der Grund."
        }
      }
    },
