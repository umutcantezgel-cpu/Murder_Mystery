        {
          "id": "e1_2_gaertner",
          "ziel": {
            "person": "gaertner"
          },
          "text": "Silas befragen",
          "fakten": [
            "f_alibi_butler",
            "f_spaet_butler"
          ]
        },
        {
          "id": "e1_2_aerztin",
          "ziel": {
            "person": "aerztin"
          },
          "text": "Doktor Marsh zu ihrem Abend befragen",
          "fakten": [
            "f_testament_marsh"
          ]
        }
      ],
      "richtig": {
        "witwe": "e1_2_gaertner",
        "butler": "e1_2_gaertner",
        "aerztin": "e1_2_gaertner",
        "neffe": "e1_2_gaertner"
      },
      "begruendung": {
        "alle": {
          "kette": [
            "beobachtung:b_inspektor_donner",
            "beobachtung:b_gaertner_fenster"
          ],
          "text": "Silas sieht von seinem Häuschen aus aufs Küchenfenster. Beim Donnerschlag hat er hinübergeschaut und weiß, ob Pell in der Küche arbeitete."
        }
      }
    },
    {
