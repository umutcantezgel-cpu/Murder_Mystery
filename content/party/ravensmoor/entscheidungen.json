  "entscheidungen": [
    {
      "id": "e1_1",
      "runde": 1,
      "nr": 1,
      "art": "person",
      "frage": "Wer saß beim Donnerschlag oben im Flur?",
      "optionen": [
        {
          "id": "e1_1_zofe",
          "ziel": {
            "person": "zofe"
          },
          "text": "Tilly befragen",
          "fakten": [
            "f_alibi_witwe",
            "f_spaet_witwe"
          ]
        },
        {
          "id": "e1_1_koechin",
          "ziel": {
            "person": "koechin"
          },
          "text": "Mrs Hobbs zum Abendessen befragen",
          "fakten": [
            "f_streit_dinner"
          ]
        }
      ],
      "richtig": {
        "witwe": "e1_1_zofe",
        "butler": "e1_1_zofe",
        "aerztin": "e1_1_zofe",
        "neffe": "e1_1_zofe"
      },
      "begruendung": {
        "alle": {
          "kette": [
            "beobachtung:b_inspektor_donner",
            "beobachtung:b_zofe_flur"
          ],
          "text": "Der Donner erschütterte um zehn nach elf das Haus. Tilly saß dabei im oberen Flur und hatte Lady Constances Tür im Blick. Sie weiß, ob die Lady in ihrem Zimmer war."
        }
      }
    },
    {
      "id": "e1_2",
      "runde": 1,
      "nr": 2,
      "art": "person",
      "frage": "Wer hatte beim Donnerschlag das Küchenfenster im Blick?",
