{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tatmatrix",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "zeit": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "pfad": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pfade": {
      "anyOf": [
        {
          "const": "alle"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pfad"
          }
        }
      ]
    },
    "idListe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "fenster": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/zeit"
      }
    }
  },
  "type": "object",
  "required": [
    "settingId",
    "pfad",
    "hinweis",
    "plaene",
    "ereignisse",
    "gegenstaende"
  ],
  "properties": {
    "settingId": {
      "$ref": "#/$defs/id"
    },
    "pfad": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "plaene": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "t"
          ],
          "properties": {
            "t": {
              "$ref": "#/$defs/zeit"
            },
            "ort": {
              "$ref": "#/$defs/id"
            },
            "nach": {
              "$ref": "#/$defs/id"
            },
            "bis": {
              "$ref": "#/$defs/zeit"
            },
            "tempo": {
              "enum": [
                "gehen",
                "rennen",
                "faellt"
              ]
            },
            "ueber": {
              "$ref": "#/$defs/idListe"
            },
            "haltung": {
              "enum": [
                "steht",
                "sitzt",
                "kauert",
                "augenbinde",
                "liegt"
              ]
            },
            "sagt": {
              "$ref": "#/$defs/text"
            },
            "geraeusch": {
              "$ref": "#/$defs/text"
            },
            "lautstaerke": {
              "enum": [
                "leise",
                "laut",
                "sehr_laut"
              ]
            },
            "licht": {
              "$ref": "#/$defs/id"
            },
            "an": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "ereignisse": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "t",
          "ort",
          "art",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "t": {
            "$ref": "#/$defs/zeit"
          },
          "ort": {
            "$ref": "#/$defs/id"
          },
          "art": {
            "enum": [
              "geraeusch",
              "geruch",
              "handlung",
              "tuer"
            ]
          },
          "lautstaerke": {
            "enum": [
              "leise",
              "laut",
              "sehr_laut"
            ]
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "person": {
            "$ref": "#/$defs/id"
          },
          "ziel": {
            "$ref": "#/$defs/id"
          },
          "tuer": {
            "$ref": "#/$defs/id"
          },
          "zustand": {
            "$ref": "#/$defs/text"
          }
        },
        "additionalProperties": false
      }
    },
    "gegenstaende": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spur"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "spur": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "t"
              ],
              "properties": {
                "t": {
                  "$ref": "#/$defs/zeit"
                },
                "traeger": {
                  "$ref": "#/$defs/id"
                },
                "ort": {
                  "$ref": "#/$defs/id"
                },
                "einrichtung": {
                  "$ref": "#/$defs/id"
                },
                "stelle": {
                  "$ref": "#/$defs/text"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "generiert": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
