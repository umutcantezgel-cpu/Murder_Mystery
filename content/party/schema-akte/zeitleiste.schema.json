{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zeitleiste",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "zeit": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "pfad": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pfade": {
      "anyOf": [
        {
          "const": "alle"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pfad"
          }
        }
      ]
    },
    "idListe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "fenster": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/zeit"
      }
    }
  },
  "type": "object",
  "required": [
    "settingId",
    "hinweis",
    "eintraege"
  ],
  "properties": {
    "settingId": {
      "$ref": "#/$defs/id"
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "eintraege": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "zeit",
          "ort",
          "wer",
          "text",
          "pfade"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "zeit": {
            "$ref": "#/$defs/zeit"
          },
          "ort": {
            "$ref": "#/$defs/id"
          },
          "wer": {
            "type": "array",
            "minItems": 0,
            "items": {
              "anyOf": [
                {
                  "$ref": "#/$defs/id"
                },
                {
                  "const": "alle"
                }
              ]
            }
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "pfade": {
            "$ref": "#/$defs/pfade"
          },
          "quelle": {
            "type": "string",
            "pattern": "^[BVA]-[0-9]{2}$"
          }
        },
        "additionalProperties": false
      }
    },
    "generiert": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
