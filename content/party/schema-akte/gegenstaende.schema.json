{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gegenstände",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "zeit": {
      "type": "string",
      "pattern": "^([01]?[0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "hex": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "pfad": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "pfade": {
      "anyOf": [
        {
          "const": "alle"
        },
        {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pfad"
          }
        }
      ]
    },
    "idListe": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "fenster": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/zeit"
      }
    }
  },
  "type": "object",
  "required": [
    "settingId",
    "hinweis",
    "gegenstaende",
    "nebendelikte"
  ],
  "properties": {
    "settingId": {
      "$ref": "#/$defs/id"
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "gegenstaende": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "beschreibung",
          "lage",
          "sichtbar"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/text"
          },
          "beschreibung": {
            "$ref": "#/$defs/text"
          },
          "lage": {
            "type": "object",
            "required": [],
            "properties": {
              "ort": {
                "$ref": "#/$defs/id"
              },
              "einrichtung": {
                "$ref": "#/$defs/id"
              },
              "traeger": {
                "$ref": "#/$defs/id"
              },
              "stelle": {
                "$ref": "#/$defs/text"
              },
              "versteckt": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          "sichtbar": {
            "type": "boolean"
          },
          "spuren": {
            "type": "array",
            "minItems": 0,
            "items": {
              "type": "object",
              "required": [
                "id",
                "stelle",
                "entstehtWenn",
                "zeigt",
                "rolle"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/id"
                },
                "stelle": {
                  "$ref": "#/$defs/text"
                },
                "entstehtWenn": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "immer"
                      ],
                      "properties": {
                        "immer": {
                          "const": true
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "kerzenstaenderGegriffenVon"
                      ],
                      "properties": {
                        "kerzenstaenderGegriffenVon": {
                          "$ref": "#/$defs/pfad"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "bundEndetBei"
                      ],
                      "properties": {
                        "bundEndetBei": {
                          "$ref": "#/$defs/id"
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "pfade"
                      ],
                      "properties": {
                        "pfade": {
                          "type": "array",
                          "minItems": 1,
                          "uniqueItems": true,
                          "items": {
                            "$ref": "#/$defs/id"
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "zeigt": {
                  "$ref": "#/$defs/text"
                },
                "harmlos": {
                  "$ref": "#/$defs/text"
                },
                "rolle": {
                  "type": "object",
                  "additionalProperties": {
                    "enum": [
                      "schluesselbeweis",
                      "zusatzindiz",
                      "fundort",
                      "nebendelikt",
                      "motiv",
                      "falsche_faehrte",
                      "ausgangslage",
                      "umgebung",
                      "ueberblick"
                    ]
                  }
                },
                "nebendelikt": {
                  "$ref": "#/$defs/id"
                },
                "widerlegt": {
                  "$ref": "#/$defs/idListe"
                },
                "belastet": {
                  "$ref": "#/$defs/idListe"
                },
                "widerlegtDurch": {
                  "$ref": "#/$defs/text"
                }
              },
              "additionalProperties": false
            }
          },
          "versteckJePfad": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [],
              "properties": {
                "ort": {
                  "$ref": "#/$defs/id"
                },
                "einrichtung": {
                  "$ref": "#/$defs/id"
                },
                "traeger": {
                  "$ref": "#/$defs/id"
                },
                "stelle": {
                  "$ref": "#/$defs/text"
                },
                "versteckt": {
                  "const": true
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "nebendelikte": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "id",
          "person",
          "text"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "person": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "duText": {
            "$ref": "#/$defs/text"
          }
        },
        "additionalProperties": false
      }
    },
    "generiert": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
