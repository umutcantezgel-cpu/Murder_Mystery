{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Textsammlung: Befragungen des Detektivs",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "schluessel": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+$"
    },
    "ref": {
      "type": "string",
      "pattern": "^(beobachtung|luege|nebendelikt|zeitleiste|spur):[a-z][a-z0-9_]*$"
    },
    "punkt": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "text"
          ],
          "additionalProperties": false,
          "properties": {
            "text": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "ref"
          ],
          "additionalProperties": false,
          "properties": {
            "ref": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      ]
    }
  },
  "type": "object",
  "required": [
    "settingId",
    "bereich",
    "hinweis",
    "eintraege"
  ],
  "additionalProperties": false,
  "properties": {
    "settingId": {
      "$ref": "#/$defs/id"
    },
    "bereich": {
      "enum": [
        "befragung"
      ]
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "eintraege": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rolle",
          "runde",
          "thema",
          "fragen",
          "stichpunkte",
          "preisgabe"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "rolle": {
            "$ref": "#/$defs/id"
          },
          "runde": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          },
          "thema": {
            "$ref": "#/$defs/text"
          },
          "fragen": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "stichpunkte": {
            "type": "array",
            "maxItems": 2,
            "items": {
              "$ref": "#/$defs/text"
            }
          },
          "preisgabe": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "generiert": {
      "type": "string",
      "minLength": 1
    }
  }
}
