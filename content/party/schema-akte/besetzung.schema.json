{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Besetzung",
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "type": "object",
  "required": [
    "settingId",
    "hinweis",
    "minRollen",
    "maxRollen",
    "reihenfolge",
    "stufen",
    "geschlechterBilanz",
    "regeln",
    "ersatzpartner"
  ],
  "additionalProperties": false,
  "properties": {
    "settingId": {
      "$ref": "#/$defs/id"
    },
    "hinweis": {
      "$ref": "#/$defs/text"
    },
    "minRollen": {
      "type": "integer",
      "minimum": 4,
      "maximum": 20
    },
    "maxRollen": {
      "type": "integer",
      "minimum": 4,
      "maximum": 20
    },
    "reihenfolge": {
      "type": "array",
      "minItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      },
      "maxItems": 20
    },
    "stufen": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "stufe",
          "plaetze"
        ],
        "additionalProperties": false,
        "properties": {
          "stufe": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "plaetze": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            }
          }
        }
      },
      "minItems": 1
    },
    "geschlechterBilanz": {
      "type": "array",
      "minItems": 1,
      "maxItems": 17,
      "items": {
        "type": "object",
        "required": [
          "rollen",
          "m",
          "w"
        ],
        "additionalProperties": false,
        "properties": {
          "rollen": {
            "type": "integer"
          },
          "m": {
            "type": "integer"
          },
          "w": {
            "type": "integer"
          }
        }
      }
    },
    "regeln": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "ersatzpartner": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "generiert": {
      "type": "string",
      "minLength": 1
    }
  }
}
